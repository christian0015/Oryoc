# MongoDB (Atlas or self-hosted) — Mongoose connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/oryoc

# NextAuth / Auth.js
# Generate with: npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret checked by /api/cron/listing-lifecycle (Authorization: Bearer <value>)
CRON_SECRET=
